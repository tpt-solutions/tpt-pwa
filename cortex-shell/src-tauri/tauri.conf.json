{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpt-cortex-shell",
  "version": "0.1.0",
  "identifier": "solutions.tpt.cortex.shell",
  "build": {
    "frontendDist": "../../pwa/dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpt-pwa",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Offline-first, app-store-free tpt-pwa shell with the cortex daemon",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/cortex-daemon"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tpt"]
      }
    }
  }
}
