// The background-sync task from spec §6. Executed by
// `cortex-engine run examples/sync.ctx`; exercised end-to-end by the test
// suite (tests/sync_ctx.rs). The daemon's embedded copy
// (cortex-daemon/internal/engineexec/sync.ctx) mirrors this one — keep both
// in sync. The host injects the task's outbox entries via
// `native.outbox.entries()`; each entry carries its `endpoint` (the
// configured sync endpoint). Clearing entries is bookkeeping the daemon
// performs when the task completes — the script only pushes.
task syncOfflineData() -> void {
    let pending = native.outbox.entries();
    if native.net.isConnected() {
        for item in pending {
            native.http.post(item.endpoint, item);
        }
    }
}
